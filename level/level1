def lru(pages, capacity):
    frames = []
    last_used = {}
    faults = 0

    for time, page in enumerate(pages):

        if page not in frames:
            faults += 1

            if len(frames) < capacity:
                frames.append(page)
            else:
                oldest = min(
                    frames,
                    key=lambda p: last_used[p]
                )

                frames[frames.index(oldest)] = page

        last_used[page] = time

    return faults
